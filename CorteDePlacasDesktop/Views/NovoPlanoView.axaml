<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CorteDePlacasDesktop.ViewModels"
             xmlns:controls="using:CorteDePlacasDesktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="660"
             x:Class="CorteDePlacasDesktop.Views.NovoPlanoView"
             x:DataType="vm:NovoPlanoViewModel"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding AdicionarPecaCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- Campos numéricos: sem setas, alinhados à direita -->
        <Style Selector="NumericUpDown">
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="FormatString" Value="0.#" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.unit">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Botão "Adicionar peça": grande e destacado -->
        <Style Selector="Button.add">
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.add:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
        </Style>

        <!-- Prévia clicável do formato da chapa -->
        <Style Selector="Button.formato">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.formato:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Botões de tipo de corte (Serra / CNC) -->
        <Style Selector="Button.tipo-corte">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.tipo-corte.ativo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        </Style>

        <!-- Imagem da peça (clicável: abre o editor), como a prévia da chapa -->
        <Style Selector="Button.desenho">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.desenho:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        </Style>
        <Style Selector="Border.imagem-peca">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
        </Style>

        <!-- Cada peça da lista: linha alta, com campos maiores e separador embaixo -->
        <Style Selector="Border.linha-peca">
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        </Style>
        <Style Selector="Border.linha-peca NumericUpDown">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="Border.linha-peca TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Tabela de peças -->
        <Style Selector="TextBlock.column-header">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.row-number">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Mensagem do rodapé -->
        <Style Selector="TextBlock.validation">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.validation.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="32,24,32,20" Spacing="2">
            <TextBlock Text="Novo plano de corte" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Informe a chapa e as peças que precisa cortar."
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Conteúdo -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="20" Margin="32,0,32,24">

            <!-- Chapa -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <Border Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section-title" Text="Chapa" />

                        <!-- Prévia do formato: clicar abre o editor -->
                        <Button Classes="formato"
                                Command="{Binding DesenharFormatoCommand}"
                                ToolTip.Tip="Abrir o editor para desenhar o formato da chapa">
                            <StackPanel Spacing="8">
                                <controls:PreviaFormato Formato="{Binding Formato}" Height="76" />
                                <TextBlock Text="{Binding DescricaoFormato}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,-6,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding MedidasFormato}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <PathIcon Width="14" Height="14"
                                                  Foreground="{DynamicResource BrandBrush}"
                                                  Data="M0,10.9 V14 H3.1 L11,6.1 L7.9,3 Z M13.7,3.4 C14.1,3 14.1,2.4 13.7,2 L12,0.3 C11.6,-0.1 11,-0.1 10.6,0.3 L9.1,1.8 L12.2,4.9 Z" />
                                        <TextBlock Text="Desenhar"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrandBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Button>

                        <!-- Chapa desenhada: as medidas vêm do desenho -->
                        <Button Classes="secondary"
                                IsVisible="{Binding EhFormatoPersonalizado}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,9"
                                Command="{Binding UsarRetanguloCommand}"
                                Content="Voltar para retângulo simples" />

                        <!-- Chapa retangular: medidas digitadas -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                              IsVisible="{Binding !EhFormatoPersonalizado}">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="Comprimento" />
                                <NumericUpDown Value="{Binding ChapaComprimento}">
                                    <NumericUpDown.InnerRightContent>
                                        <TextBlock Classes="unit" Text="mm" />
                                    </NumericUpDown.InnerRightContent>
                                </NumericUpDown>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="label" Text="Largura" />
                                <NumericUpDown Value="{Binding ChapaLargura}">
                                    <NumericUpDown.InnerRightContent>
                                        <TextBlock Classes="unit" Text="mm" />
                                    </NumericUpDown.InnerRightContent>
                                </NumericUpDown>
                            </StackPanel>
                        </Grid>

                        <!-- Tipo de corte: o operador escolhe como a máquina corta -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Tipo de corte" Margin="0" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Classes="tipo-corte" Classes.ativo="{Binding EhSerra}"
                                        Command="{Binding UsarSerraCommand}"
                                        ToolTip.Tip="Seccionadora ou esquadrejadeira: cada corte atravessa o pedaço inteiro">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <!-- disco de serra -->
                                        <PathIcon Width="16" Height="16"
                                                  Data="M8,0 L9.2,2.1 L11.5,0.8 L11.8,3.2 L14.4,3.3 L13.4,5.6 L15.6,7 L13.6,8.6 L15,10.8 L12.5,11.4 L12.6,14 L10.2,13.3 L8.9,15.5 L7.4,13.5 L5.2,14.8 L4.8,12.3 L2.2,12.1 L3.2,9.8 L1,8.4 L3,6.8 L1.6,4.6 L4.2,4 L4,1.4 L6.4,2.2 Z M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5 Z" />
                                        <TextBlock Text="Serra" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="tipo-corte" Classes.ativo="{Binding EhCnc}"
                                        Command="{Binding UsarCncCommand}"
                                        ToolTip.Tip="CNC ou router: as peças podem ficar em qualquer posição">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <!-- fresa -->
                                        <PathIcon Width="12" Height="16"
                                                  Data="M2,0 H10 V5 H2 Z M4,5 H8 V8 L10,10 L2,12 L10,14 L6,16 L4,15.2 L7,14 L1,12.5 L8,10.6 L4,8.6 Z" />
                                        <TextBlock Text="CNC" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Classes="hint" Text="{Binding DescricaoTipoCorte}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="{Binding RotuloEspessura}"
                                           ToolTip.Tip="{Binding DicaEspessura}" />
                                <NumericUpDown Value="{Binding EspessuraSerra}">
                                    <NumericUpDown.InnerRightContent>
                                        <TextBlock Classes="unit" Text="mm" />
                                    </NumericUpDown.InnerRightContent>
                                </NumericUpDown>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="label" Text="Aparar bordas"
                                           ToolTip.Tip="Quanto tirar de cada borda da chapa para deixá-la reta e limpa. Use 0 se as bordas já estão boas." />
                                <NumericUpDown Value="{Binding Refilo}">
                                    <NumericUpDown.InnerRightContent>
                                        <TextBlock Classes="unit" Text="mm" />
                                    </NumericUpDown.InnerRightContent>
                                </NumericUpDown>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Peças -->
            <Border Grid.Column="1" Classes="card" Padding="20,20,20,8">
                <Grid RowDefinitions="Auto,Auto,*">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Classes="section-title" Text="Peças" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="add"
                                Command="{Binding AdicionarPecaCommand}"
                                ToolTip.Tip="Adicionar peça (Ctrl+Enter)">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Width="16" Height="16"
                                          Data="M7,0 H9 V7 H16 V9 H9 V16 H7 V9 H0 V7 H7 Z" />
                                <TextBlock Text="Adicionar peça" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Cabeçalho (mesmas colunas da linha de cima de cada peça) -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="28,176,*,*,84,36"
                          ColumnSpacing="10"
                          Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Classes="column-header" Text="#" />
                        <TextBlock Grid.Column="1" Classes="column-header" Text="Formato"
                                   ToolTip.Tip="Imagem da peça. Clique para desenhar peças que não são retângulos, como a chapa." />
                        <TextBlock Grid.Column="2" Classes="column-header" Text="Comprimento (mm)" />
                        <TextBlock Grid.Column="3" Classes="column-header" Text="Largura (mm)" />
                        <TextBlock Grid.Column="4" Classes="column-header" Text="Qtd." />
                    </Grid>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ListaPecas" ItemsSource="{Binding Pecas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PecaViewModel">
                                    <!-- Cada peça: imagem à esquerda; medidas em cima e descrição embaixo -->
                                    <Border Classes="linha-peca">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="28,176,*,*,84,36"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnSpacing="10"
                                                  RowSpacing="8">
                                                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                           Classes="row-number"
                                                           Text="{Binding Numero}" />

                                                <!-- Espaço da imagem da peça (retângulo ou desenho); clicar abre o editor -->
                                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                        Classes="desenho"
                                                        Command="{Binding DesenharCommand}"
                                                        ToolTip.Tip="Desenhar o formato desta peça">
                                                    <Grid RowDefinitions="*,Auto" RowSpacing="3">
                                                        <Border Grid.Row="0" Classes="imagem-peca">
                                                            <Panel>
                                                                <controls:PreviaFormato Formato="{Binding FormatoPrevia}"
                                                                                        Margem="6"
                                                                                        Preenchimento="{DynamicResource BrandSoftBrush}"
                                                                                        Borda="{DynamicResource BrandBrush}" />
                                                                <TextBlock Text="sem medidas"
                                                                           IsVisible="{Binding !TemPrevia}"
                                                                           FontSize="12"
                                                                           FontWeight="Normal"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Row="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="5"
                                                                    HorizontalAlignment="Center">
                                                            <PathIcon Width="12" Height="12"
                                                                      Data="M0,10.9 V14 H3.1 L11,6.1 L7.9,3 Z M13.7,3.4 C14.1,3 14.1,2.4 13.7,2 L12,0.3 C11.6,-0.1 11,-0.1 10.6,0.3 L9.1,1.8 L12.2,4.9 Z" />
                                                            <TextBlock Text="Desenhar"
                                                                       IsVisible="{Binding EhRetangular}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="Editar desenho"
                                                                       IsVisible="{Binding EhDesenhada}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <!-- Em cima: medidas e quantidade (peça desenhada: medidas vêm do desenho) -->
                                                <NumericUpDown Grid.Row="0" Grid.Column="2"
                                                               Value="{Binding Comprimento}"
                                                               IsEnabled="{Binding EhRetangular}" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="3"
                                                               Value="{Binding Largura}"
                                                               IsEnabled="{Binding EhRetangular}" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="4"
                                                               Value="{Binding Quantidade}"
                                                               Minimum="1"
                                                               FormatString="0"
                                                               ParsingNumberStyle="Integer" />

                                                <!-- Embaixo: descrição -->
                                                <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                                         Text="{Binding Descricao}"
                                                         PlaceholderText="Descrição (ex.: Lateral)" />

                                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="5"
                                                        Classes="subtle"
                                                        Padding="10"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding RemoverCommand}"
                                                        ToolTip.Tip="Remover peça">
                                                    <PathIcon Width="11" Height="11"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              Data="M1.4,0 L5,3.6 L8.6,0 L10,1.4 L6.4,5 L10,8.6 L8.6,10 L5,6.4 L1.4,10 L0,8.6 L3.6,5 L0,1.4 Z" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Classes="hint danger"
                                                       Margin="224,0,0,0"
                                                       Text="{Binding Aviso}"
                                                       IsVisible="{Binding Aviso, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2"
                Padding="32,14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0"
                           Text="{Binding Resumo}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Classes="validation"
                           Classes.danger="{Binding MensagemEhErro}"
                           Text="{Binding MensagemValidacao}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Classes="accent"
                        Padding="20,10"
                        Command="{Binding CalcularCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Calcular plano" FontWeight="SemiBold" IsVisible="{Binding !Calculando}" />
                        <TextBlock Text="Calculando…" FontWeight="SemiBold" IsVisible="{Binding Calculando}" />
                        <PathIcon Width="12" Height="11"
                                  Data="M6.6,0 L5.2,1.4 L8.3,4.5 H0 V6.5 H8.3 L5.2,9.6 L6.6,11 L12,5.5 Z" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>

</UserControl>
