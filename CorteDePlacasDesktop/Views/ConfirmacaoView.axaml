<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CorteDePlacasDesktop.ViewModels"
             x:Class="CorteDePlacasDesktop.Views.ConfirmacaoView"
             x:DataType="vm:ConfirmacaoViewModel"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- A margem reserva espaço para a sombra -->
    <Border Width="460"
            Margin="48"
            Padding="28"
            CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 16 48 0 #40000000"
            KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <!-- Ícone de alerta -->
                <Border Width="44" Height="44"
                        CornerRadius="22"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DangerSoftBrush}">
                    <PathIcon Width="4" Height="20"
                              Foreground="{DynamicResource DangerBrush}"
                              Data="M0,0 H4 V13 H0 Z M0,16 H4 V20 H0 Z" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{Binding Titulo}"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Mensagem}"
                               FontSize="15"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <!-- "Cancelar" vem focado e responde ao Esc: é a opção segura -->
                <Button x:Name="BotaoCancelar"
                        Classes="secondary large"
                        IsCancel="True"
                        Content="{Binding TextoCancelar}"
                        Command="{Binding CancelarCommand}" />
                <Button Classes="danger large"
                        Content="{Binding TextoConfirmar}"
                        Command="{Binding ConfirmarCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
