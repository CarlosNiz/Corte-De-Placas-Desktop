<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CorteDePlacasDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="700"
             x:Class="CorteDePlacasDesktop.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Cartões -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Botão secundário com contorno -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Número do passo -->
        <Style Selector="Border.step-number">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
        </Style>
        <Style Selector="Border.step-number > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.step-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.step-text">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Peças do desenho de exemplo -->
        <Style Selector="Border.piece">
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            <Setter Property="BorderThickness" Value="0.8" />
        </Style>
        <Style Selector="Border.piece > TextBlock">
            <Setter Property="FontSize" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1080" Margin="40,36,40,32" Spacing="40"
                    VerticalAlignment="Center">

            <!-- Apresentação + exemplo -->
            <Grid ColumnDefinitions="6*,48,5*">

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="OTIMIZAÇÃO DE CORTE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               LetterSpacing="1.2"
                               Foreground="{DynamicResource BrandBrush}" />
                    <TextBlock Text="Aproveite melhor cada chapa"
                               FontSize="34"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Informe as medidas da chapa e as peças que precisa cortar. O aplicativo calcula a posição de cada corte para reduzir as sobras."
                               FontSize="15"
                               LineHeight="24"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                        <Button Classes="accent"
                                Padding="20,12"
                                Command="{Binding NovoPlanoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="13" Height="13"
                                          Data="M7,0 H9 V7 H16 V9 H9 V16 H7 V9 H0 V7 H7 Z" />
                                <TextBlock Text="Novo plano de corte" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary"
                                Padding="20,12"
                                Command="{Binding AbrirPlanoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="15" Height="13"
                                          Data="M0,3 C0,1.9 0.9,1 2,1 H6 L8,3 H14 C15.1,3 16,3.9 16,5 V13 C16,14.1 15.1,15 14,15 H2 C0.9,15 0,14.1 0,13 Z" />
                                <TextBlock Text="Abrir plano" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Classes="card" Padding="24">
                    <StackPanel Spacing="14">
                        <!-- Chapa 2750 × 1850 mm desenhada na escala 1:10 -->
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="275" Height="185">
                                <Rectangle Width="275" Height="185"
                                           Fill="{DynamicResource SheetBrush}"
                                           Stroke="{DynamicResource SheetBorderBrush}"
                                           StrokeThickness="1" />

                                <Border Classes="piece" Canvas.Left="6" Canvas.Top="6" Width="110" Height="70">
                                    <TextBlock Text="1100 × 700" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="6" Canvas.Top="79" Width="110" Height="70">
                                    <TextBlock Text="1100 × 700" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="6" Canvas.Top="152" Width="110" Height="27">
                                    <TextBlock Text="1100 × 270" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="119" Canvas.Top="6" Width="70" Height="95">
                                    <TextBlock Text="700 × 950" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="192" Canvas.Top="6" Width="77" Height="95">
                                    <TextBlock Text="770 × 950" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="119" Canvas.Top="104" Width="150" Height="45">
                                    <TextBlock Text="1500 × 450" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="119" Canvas.Top="152" Width="60" Height="27">
                                    <TextBlock Text="600 × 270" />
                                </Border>
                                <Border Classes="piece" Canvas.Left="182" Canvas.Top="152" Width="60" Height="27">
                                    <TextBlock Text="600 × 270" />
                                </Border>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Exemplo de plano de corte · chapa 2750 × 1850 mm"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Como funciona -->
            <StackPanel Spacing="16">
                <TextBlock Text="Como funciona" FontSize="18" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,16,*,16,*">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="10">
                            <Border Classes="step-number">
                                <TextBlock Text="1" />
                            </Border>
                            <TextBlock Classes="step-title" Text="Defina a chapa" />
                            <TextBlock Classes="step-text"
                                       Text="Informe a largura e o comprimento da chapa que você tem disponível." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="10">
                            <Border Classes="step-number">
                                <TextBlock Text="2" />
                            </Border>
                            <TextBlock Classes="step-title" Text="Liste as peças" />
                            <TextBlock Classes="step-text"
                                       Text="Adicione cada corte com suas medidas e a quantidade necessária." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Classes="card">
                        <StackPanel Spacing="10">
                            <Border Classes="step-number">
                                <TextBlock Text="3" />
                            </Border>
                            <TextBlock Classes="step-title" Text="Calcule o plano" />
                            <TextBlock Classes="step-text"
                                       Text="O aplicativo posiciona as peças na chapa e mostra o plano de corte com o aproveitamento." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
