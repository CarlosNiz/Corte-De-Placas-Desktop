<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CorteDePlacasDesktop.App"
             xmlns:local="using:CorteDePlacasDesktop"
             RequestedThemeVariant="Default">
             <!-- "Default" segue o tema do sistema (claro/escuro). -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E1E4E8" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D21" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6370" />
                    <SolidColorBrush x:Key="BrandBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#FDEBDD" />
                    <SolidColorBrush x:Key="SheetBrush" Color="#EFE6D8" />
                    <SolidColorBrush x:Key="SheetBorderBrush" Color="#B9A98F" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE4E2" />
                    <SolidColorBrush x:Key="DangerStrongBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="DangerStrongHoverBrush" Color="#912018" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#067647" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFAE6" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#661A1D21" />
                    <SolidColorBrush x:Key="GridMinorBrush" Color="#F0F1F3" />
                    <SolidColorBrush x:Key="HighlightBrush" Color="#1FC2410C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#16181C" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#202328" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#30343B" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3AF" />
                    <SolidColorBrush x:Key="BrandBrush" Color="#FB8A4C" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#3A2416" />
                    <SolidColorBrush x:Key="SheetBrush" Color="#2B2721" />
                    <SolidColorBrush x:Key="SheetBorderBrush" Color="#5C5245" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#F97066" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3D1A17" />
                    <SolidColorBrush x:Key="DangerStrongBrush" Color="#D92D20" />
                    <SolidColorBrush x:Key="DangerStrongHoverBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#47CD89" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0B3A26" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="GridMinorBrush" Color="#272A30" />
                    <SolidColorBrush x:Key="HighlightBrush" Color="#2EFB8A4C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#C2410C" />
                <ColorPaletteResources x:Key="Dark" Accent="#EA580C" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Estilos comuns a todas as telas -->

        <!-- Cartão -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Botão secundário com contorno -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Botão da barra superior (ex.: Início) -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Botão grande (diálogos) -->
        <Style Selector="Button.large">
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Botão de ação destrutiva (ex.: descartar) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerStrongHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Botão discreto, sem fundo -->
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Títulos e textos de apoio -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </Application.Styles>
</Application>
